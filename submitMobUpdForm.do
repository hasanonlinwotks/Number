				return true;
			}
			else if(keyCode == 45 || keyCode == 47)
			{
				return true;
			}
			else if(keyCode == 8 ||  keyCode == 37 || keyCode == 39 || keyCode == 46 || keyCode == 32 || keyCode == 9)
			{
				return true;
			}
			else
			{
				return false;
			}
		}
	}
	
	
