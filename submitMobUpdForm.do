	function allowHiphenAndSlash(e)
	{
		var keyCode = null;
		if(e.which)
		{
			keyCode = e.which;
			if((keyCode >= 65 && keyCode <= 90) || (keyCode >= 97 && keyCode <= 122))
			{
				return true;
			}
			else if(keyCode >= 48 && keyCode <= 57)
			{
				return true;
			}
			else if(keyCode == 45 || keyCode == 47)
			{
				return true;
			}
			else if(keyCode == 8 || keyCode == 32)
			{
				return true;
			}
			else
			{
				return false;
			}
		}
		else if(e.keyCode)
		{
			keyCode = e.keyCode;
			if((keyCode >= 65 && keyCode <= 90) || (keyCode >= 97 && keyCode <= 122))
			{
				return true;
			}
			else if(keyCode >= 48 && keyCode <= 57)
